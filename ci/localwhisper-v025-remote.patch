diff --git a/app/src/main/java/win/fantest/localwhisper/RemoteTranscriptionClient.java b/app/src/main/java/win/fantest/localwhisper/RemoteTranscriptionClient.java
new file mode 100644
index 0000000..6a1134d
--- /dev/null
+++ b/app/src/main/java/win/fantest/localwhisper/RemoteTranscriptionClient.java
@@ -0,0 +1,158 @@
+package win.fantest.localwhisper;
+
+import org.json.JSONObject;
+
+import java.io.BufferedInputStream;
+import java.io.BufferedReader;
+import java.io.DataOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+
+public final class RemoteTranscriptionClient {
+    public static final class Result {
+        public final String text;
+        public final String language;
+        public final long durationMs;
+        public final long processingMs;
+        public final String engine;
+        public final String modelId;
+        public final String modelName;
+
+        Result(String text, String language, long durationMs, long processingMs,
+               String engine, String modelId, String modelName) {
+            this.text = text;
+            this.language = language;
+            this.durationMs = durationMs;
+            this.processingMs = processingMs;
+            this.engine = engine;
+            this.modelId = modelId;
+            this.modelName = modelName;
+        }
+    }
+
+    private static final int CONNECT_TIMEOUT_MS = 6000;
+    private static final int READ_TIMEOUT_MS = 15 * 60 * 1000;
+
+    private RemoteTranscriptionClient() {}
+
+    public static Result transcribe(
+            File audio,
+            String language,
+            String output,
+            boolean timestamps,
+            String performance,
+            String modelId
+    ) throws Exception {
+        if (audio == null || !audio.isFile() || audio.length() == 0L) {
+            throw new IllegalArgumentException("Audio file is unavailable");
+        }
+
+        String boundary = "----LocalWhisper" + Long.toHexString(System.nanoTime());
+        URL url = new URL(AppPrefs.REMOTE_BASE_URL + "/v1/transcribe");
+        HttpURLConnection connection = (HttpURLConnection) url.openConnection();
+        connection.setConnectTimeout(CONNECT_TIMEOUT_MS);
+        connection.setReadTimeout(READ_TIMEOUT_MS);
+        connection.setRequestMethod("POST");
+        connection.setDoOutput(true);
+        connection.setUseCaches(false);
+        connection.setRequestProperty("Accept", "application/json");
+        connection.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);
+
+        try (DataOutputStream out = new DataOutputStream(connection.getOutputStream())) {
+            field(out, boundary, "language", language == null ? "auto" : language);
+            field(out, boundary, "output", output == null ? "original" : output);
+            field(out, boundary, "timestamps", timestamps ? "true" : "false");
+            field(out, boundary, "performance", performance == null ? "fast" : performance);
+            field(out, boundary, "model_id", modelId == null ? ModelCatalog.QUALITY : modelId);
+
+            out.writeBytes("--" + boundary + "\r\n");
+            out.writeBytes("Content-Disposition: form-data; name=\"file\"; filename=\"" +
+                    safeName(audio.getName()) + "\"\r\n");
+            out.writeBytes("Content-Type: application/octet-stream\r\n\r\n");
+            try (BufferedInputStream in = new BufferedInputStream(new FileInputStream(audio))) {
+                byte[] buffer = new byte[256 * 1024];
+                int count;
+                while ((count = in.read(buffer)) != -1) out.write(buffer, 0, count);
+            }
+            out.writeBytes("\r\n--" + boundary + "--\r\n");
+            out.flush();
+        }
+
+        int code = connection.getResponseCode();
+        InputStream stream = code >= 200 && code < 300
+                ? connection.getInputStream()
+                : connection.getErrorStream();
+        String body = readAll(stream);
+        connection.disconnect();
+
+        if (code < 200 || code >= 300) {
+            String detail = body;
+            try {
+                detail = new JSONObject(body).optString("detail", body);
+            } catch (Exception ignored) {}
+            throw new IllegalStateException("Master PC HTTP " + code + ": " + detail);
+        }
+
+        JSONObject json = new JSONObject(body);
+        if (!json.optBoolean("ok", false)) {
+            throw new IllegalStateException(json.optString("detail", "Master PC transcription failed"));
+        }
+
+        String text = json.optString("text", "").trim();
+        if (text.isEmpty()) throw new IllegalStateException("Master PC returned no text");
+
+        return new Result(
+                text,
+                json.optString("language", ""),
+                json.optLong("duration_ms", 0L),
+                json.optLong("processing_ms", 0L),
+                json.optString("engine", "master-pc"),
+                json.optString("model_id", modelId),
+                json.optString("model", "")
+        );
+    }
+
+    public static boolean healthCheck() {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(AppPrefs.REMOTE_BASE_URL + "/health").openConnection();
+            connection.setConnectTimeout(2500);
+            connection.setReadTimeout(2500);
+            connection.setRequestMethod("GET");
+            int code = connection.getResponseCode();
+            if (code != 200) return false;
+            String body = readAll(connection.getInputStream());
+            return new JSONObject(body).optBoolean("ok", false);
+        } catch (Exception ignored) {
+            return false;
+        } finally {
+            if (connection != null) connection.disconnect();
+        }
+    }
+
+    private static void field(DataOutputStream out, String boundary, String name, String value) throws Exception {
+        out.writeBytes("--" + boundary + "\r\n");
+        out.writeBytes("Content-Disposition: form-data; name=\"" + name + "\"\r\n\r\n");
+        out.write(value.getBytes(StandardCharsets.UTF_8));
+        out.writeBytes("\r\n");
+    }
+
+    private static String safeName(String name) {
+        return name == null ? "audio.bin" : name.replace("\"", "_").replace("\r", "_").replace("\n", "_");
+    }
+
+    private static String readAll(InputStream input) throws Exception {
+        if (input == null) return "";
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(input, StandardCharsets.UTF_8))) {
+            StringBuilder out = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) out.append(line);
+            return out.toString();
+        }
+    }
+}
