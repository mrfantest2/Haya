+$ErrorActionPreference = "SilentlyContinue"
+$root = "C:\LocalWhisper\remote-server"
+$python = "$root\venv\Scripts\python.exe"
+$server = "$root\server.py"
+$tailscale = "C:\Program Files\Tailscale\tailscale.exe"
+$log = "$root\logs\launcher.log"
+
+function Log($m) {
+    ("{0:u} {1}" -f (Get-Date), $m) | Add-Content -Path $log -Encoding UTF8
+}
+
+while ($true) {
+    try {
+        $ip = (& $tailscale ip -4 2>$null | Select-Object -First 1).Trim()
+        if (!$ip) {
+            Log "Waiting for Tailscale"
+            Start-Sleep -Seconds 10
+            continue
+        }
+        $env:LOCALWHISPER_REMOTE_BIND = $ip
+        Log ("Starting server on " + $ip + ":8766")
+        & $python $server
+        Log ("Server exited with code " + $LASTEXITCODE)
+    } catch {
+        Log ("Launcher error: " + $_.Exception.Message)
+    }
+    Start-Sleep -Seconds 5
+}
