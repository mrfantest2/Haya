+package win.fantest.localwhisper;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.Service;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.os.Build;
+import android.os.IBinder;
+
+import java.io.File;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+public final class TranscriptionService extends Service {
+    public static final String ACTION_PROCESS = "win.fantest.localwhisper.PROCESS";
+    public static final String ACTION_CHANGED = "win.fantest.localwhisper.CHANGED";
+    public static final String ACTION_PROGRESS = "win.fantest.localwhisper.PROGRESS";
+
+    public static final String EXTRA_JOB_ID = "job_id";
+    public static final String EXTRA_NAME = "name";
+    public static final String EXTRA_STAGE = "stage";
+    public static final String EXTRA_PROGRESS = "progress";
+    public static final String EXTRA_PREVIEW = "preview";
+
+    private static final String CHANNEL_ID = "transcription";
+    private static final int NOTIFICATION_ID = 4101;
+
+    private ExecutorService executor;
+    private final AtomicBoolean draining = new AtomicBoolean(false);
+    private TranscriptionStateStore liveState;
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        executor = Executors.newSingleThreadExecutor();
+        liveState = new TranscriptionStateStore(this);
+        createNotificationChannel();
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        startForegroundCompat(notification("Preparing transcription…", 0, 0));
+        if (draining.compareAndSet(false, true)) {
+            executor.submit(() -> {
+                try {
+                    drainQueue();
+                } finally {
+                    draining.set(false);
+                    WhisperEngineCache.releaseLater();
+                    stopForeground(STOP_FOREGROUND_REMOVE);
+                    stopSelfResult(startId);
+                }
+            });
+        }
+        return START_REDELIVER_INTENT;
+    }
+
+    private void drainQueue() {
+        TranscriptDb db = new TranscriptDb(this);
+        db.resetInterrupted();
+        AppPrefs prefs = new AppPrefs(this);
+        ModelManager modelManager = new ModelManager(this);
+
+        TranscriptDb.Job job;
+        while ((job = db.nextPending()) != null) {
+            String modelId = job.modelId == null || job.modelId.isBlank() ? prefs.model() : job.modelId;
+            String performanceProfile = normalizePerformanceProfile(job.performanceProfile, prefs.performanceProfile());
+            File audio = new File(job.audioPath == null ? "" : job.audioPath);
+            int remaining = db.pendingCount();
+
+            if (!audio.isFile()) {
+                String error = "Original audio is no longer available";
+                db.markFailed(job.id, error);
+                liveState.fail(job.id, job.name, error);
+                sendProgress(job, "Failed", -1, error);
+                notifyChanged();
+                continue;
+            }
+
+            db.markProcessing(job.id, modelId, performanceProfile);
+            long started = System.currentTimeMillis();
+
+            if (prefs.remoteFirst()) {
+                try {
+                    report(job, "Sending to Master PC", 5, "", remaining, true);
+                    RemoteTranscriptionClient.Result remote = RemoteTranscriptionClient.transcribe(
+                            audio,
+                            prefs.language(),
+                            prefs.outputMode(),
+                            prefs.timestamps(),
+                            performanceProfile,
+                            modelId
+                    );
+                    long elapsed = Math.max(1L, System.currentTimeMillis() - started);
+                    String finalModelId = remote.modelId == null || remote.modelId.isBlank() ? modelId : remote.modelId;
+                    db.markDone(
+                            job.id,
+                            remote.text,
+                            remote.language,
+                            remote.durationMs,
+                            finalModelId,
+                            performanceProfile,
+                            elapsed,
+                            "master-pc"
+                    );
+                    liveState.complete(job.id, job.name, remote.text);
+                    sendProgress(job, "Complete · Master PC", 100, remote.text);
+                    if (!prefs.keepAudio() && db.audioReferenceCount(job.audioPath) <= 1) audio.delete();
+                    String speed = remote.durationMs > 0L
+                            ? String.format(java.util.Locale.US, " · %.2fx realtime", (double) remote.durationMs / (double) elapsed)
+                            : "";
+                    updateNotification("Finished on Master PC · " + job.name + " · " + elapsed / 1000L + "s" + speed, 100, 100);
+                    notifyChanged();
+                    continue;
+                } catch (Throwable remoteError) {
+                    String reason = readableError(remoteError);
+                    report(job, "Master PC unavailable · local fallback", -1, reason, remaining, true);
+                    if (!modelManager.isInstalled(modelId)) {
+                        String error = "Master PC unavailable: " + reason + " · local model not installed";
+                        db.markFailed(job.id, error);
+                        liveState.fail(job.id, job.name, error);
+                        sendProgress(job, "Failed", -1, error);
+                        notifyChanged();
+                        continue;
+                    }
+                }
+            }
+
+            File model = modelManager.modelFile(modelId);
+            if (!modelManager.isInstalled(modelId)) {
+                String error = "Model not installed: " + ModelCatalog.get(modelId).title;
+                db.markFailed(job.id, error);
+                liveState.fail(job.id, job.name, error);
+                sendProgress(job, "Failed", -1, error);
+                notifyChanged();
+                continue;
+            }
+
+            report(job, "Loading local Whisper · " + ModelCatalog.get(modelId).title, -1, "", remaining, true);
+            long engine = WhisperEngineCache.acquire(model.getAbsolutePath());
+            if (engine == 0L) {
+                String error = "Could not load local Whisper model";
+                db.markFailed(job.id, error);
+                liveState.fail(job.id, job.name, error);
+                sendProgress(job, "Failed", -1, error);
+                notifyChanged();
+                continue;
+            }
+
+            report(job, "Decoding voice note locally", -1, "", remaining, true);
+            try {
+                AudioDecoder.DecodedAudio decoded = AudioDecoder.decode(audio);
+                report(job, "Preparing local transcription", -1, "", remaining, true);
+
+                String language = prefs.language();
+                boolean timestamps = prefs.timestamps();
+                String outputMode = prefs.outputMode();
+                String result;
+                String detected;
+
+                if (AppPrefs.OUTPUT_ENGLISH.equals(outputMode)) {
+                    ProgressEmitter emitter = new ProgressEmitter(job, "Translating locally", 0, 1, remaining);
+                    result = WhisperNative.transcribe(engine, decoded.samples, language, true, timestamps, performanceProfile, emitter);
+                    detected = WhisperNative.detectedLanguage(engine);
+                } else if (AppPrefs.OUTPUT_BOTH.equals(outputMode)) {
+                    ProgressEmitter originalEmitter = new ProgressEmitter(job, "Transcribing locally", 0, 2, remaining);
+                    String original = WhisperNative.transcribe(engine, decoded.samples, language, false, timestamps, performanceProfile, originalEmitter);
+                    detected = WhisperNative.detectedLanguage(engine);
+                    ProgressEmitter englishEmitter = new ProgressEmitter(job, "Translating locally", 1, 2, remaining);
+                    String english = WhisperNative.transcribe(engine, decoded.samples, language, true, timestamps, performanceProfile, englishEmitter);
+                    result = "Original:\n" + original + "\n\nEnglish:\n" + english;
+                } else {
+                    ProgressEmitter emitter = new ProgressEmitter(job, "Transcribing locally", 0, 1, remaining);
+                    result = WhisperNative.transcribe(engine, decoded.samples, language, false, timestamps, performanceProfile, emitter);
+                    detected = WhisperNative.detectedLanguage(engine);
+                }
+
+                if (result == null || result.trim().isEmpty()) {
+                    throw new IllegalStateException("Whisper returned no text");
+                }
+
+                long elapsed = Math.max(1L, System.currentTimeMillis() - started);
+                String finalText = result.trim();
+                db.markDone(job.id, finalText, detected, decoded.durationMs, modelId, performanceProfile, elapsed, "device");
+                liveState.complete(job.id, job.name, finalText);
+                sendProgress(job, "Complete · on-device", 100, finalText);
+                if (!prefs.keepAudio() && db.audioReferenceCount(job.audioPath) <= 1) audio.delete();
+                String speed = decoded.durationMs > 0L
+                        ? String.format(java.util.Locale.US, " · %.2fx realtime", (double) decoded.durationMs / (double) elapsed)
+                        : "";
+                updateNotification("Finished on-device · " + job.name + " · " + elapsed / 1000L + "s" + speed, 100, 100);
+            } catch (Throwable t) {
+                String error = readableError(t);
+                db.markFailed(job.id, error);
+                liveState.fail(job.id, job.name, error);
+                sendProgress(job, "Failed", -1, error);
+            }
+            notifyChanged();
+        }
+        notifyChanged();
+    }
+
+    private static String normalizePerformanceProfile(String jobMode, String fallback) {
+        String value = jobMode == null || jobMode.isBlank() ? fallback : jobMode;
+        if (AppPrefs.PERFORMANCE_BALANCED.equals(value) || AppPrefs.PERFORMANCE_ACCURATE.equals(value)) return value;
+        return AppPrefs.PERFORMANCE_FAST;
+    }
+
+
+    private final class ProgressEmitter implements WhisperNative.ProgressListener {
+        private final TranscriptDb.Job job;
+        private final String stage;
+        private final int passIndex;
+        private final int passCount;
+        private final int remaining;
+        private int lastProgress = -10;
+        private String lastPreview = "";
+
+        ProgressEmitter(TranscriptDb.Job job, String stage, int passIndex, int passCount, int remaining) {
+            this.job = job;
+            this.stage = stage;
+            this.passIndex = passIndex;
+            this.passCount = passCount;
+            this.remaining = remaining;
+        }
+
+        @Override public void onProgress(int percent, String partialText) {
+            int mapped = ProgressMapper.mapPass(percent, passIndex, passCount);
+            String preview = partialText == null ? "" : partialText.trim();
+            boolean changedText = !preview.equals(lastPreview);
+            if (mapped < 100 && mapped - lastProgress < 2 && !changedText) return;
+            lastProgress = mapped;
+            lastPreview = preview;
+            report(job, stage, mapped, preview, remaining, true);
+        }
+    }
+
+    private void report(TranscriptDb.Job job, String stage, int progress, String preview,
+                        int remaining, boolean notifyUi) {
+        liveState.update(job.id, job.name, stage, progress, preview);
+        updateNotification(stage + " · " + job.name, progress < 0 ? 0 : progress, progress < 0 ? 0 : 100);
+        if (notifyUi) sendProgress(job, stage, progress, preview);
+        notifyChanged();
+    }
+
+    private void sendProgress(TranscriptDb.Job job, String stage, int progress, String preview) {
+        Intent i = new Intent(ACTION_PROGRESS)
+                .setPackage(getPackageName())
+                .putExtra(EXTRA_JOB_ID, job.id)
+                .putExtra(EXTRA_NAME, job.name)
+                .putExtra(EXTRA_STAGE, stage)
+                .putExtra(EXTRA_PROGRESS, progress)
+                .putExtra(EXTRA_PREVIEW, preview == null ? "" : preview);
+        sendBroadcast(i);
+    }
+
+    private static String readableError(Throwable t) {
+        String message = t.getMessage();
+        if (message == null || message.trim().isEmpty()) message = t.getClass().getSimpleName();
+        return message;
+    }
+
+    private void notifyChanged() {
+        sendBroadcast(new Intent(ACTION_CHANGED).setPackage(getPackageName()));
+    }
+
+    private void createNotificationChannel() {
+        if (Build.VERSION.SDK_INT >= 26) {
+            NotificationChannel channel = new NotificationChannel(
+                    CHANNEL_ID,
+                    getString(R.string.channel_name),
+                    NotificationManager.IMPORTANCE_LOW
+            );
+            channel.setDescription(getString(R.string.channel_description));
+            ((NotificationManager) getSystemService(NOTIFICATION_SERVICE)).createNotificationChannel(channel);
+        }
+    }
+
+    private Notification notification(String text, int progress, int max) {
+        Notification.Builder builder = Build.VERSION.SDK_INT >= 26
+                ? new Notification.Builder(this, CHANNEL_ID)
+                : new Notification.Builder(this);
+
+        builder.setContentTitle("Local Whisper")
+                .setContentText(text)
+                .setSmallIcon(R.drawable.ic_notification)
+                .setOngoing(true)
+                .setOnlyAlertOnce(true);
+
+        if (max > 0) builder.setProgress(max, Math.max(0, Math.min(max, progress)), false);
+        else builder.setProgress(0, 0, true);
+        return builder.build();
+    }
+
+    private void updateNotification(String text, int progress, int max) {
+        ((NotificationManager) getSystemService(NOTIFICATION_SERVICE))
+                .notify(NOTIFICATION_ID, notification(text, progress, max));
+    }
+
+    private void startForegroundCompat(Notification notification) {
+        if (Build.VERSION.SDK_INT >= 35) {
+            startForeground(NOTIFICATION_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROCESSING);
+        } else {
+            startForeground(NOTIFICATION_ID, notification);
+        }
+    }
+
+    @Override public void onDestroy() {
+        if (executor != null) executor.shutdownNow();
+        super.onDestroy();
+    }
+
+    @Override public IBinder onBind(Intent intent) { return null; }
+}
