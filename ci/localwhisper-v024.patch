diff --git a/tools/v024_performance_contract_test.py b/tools/v024_performance_contract_test.py
new file mode 100644
index 0000000..87bfaf6
--- /dev/null
+++ b/tools/v024_performance_contract_test.py
@@ -0,0 +1,33 @@
+from pathlib import Path
+root = Path(__file__).resolve().parents[1]
+def txt(rel): return (root / rel).read_text()
+
+build = txt('app/build.gradle.kts')
+cmake = txt('app/src/main/cpp/CMakeLists.txt')
+native = txt('app/src/main/cpp/native-lib.cpp')
+prefs = txt('app/src/main/java/win/fantest/localwhisper/AppPrefs.java')
+ui = txt('app/src/main/java/win/fantest/localwhisper/MainUi.java')
+main = txt('app/src/main/java/win/fantest/localwhisper/MainActivity.java')
+service = txt('app/src/main/java/win/fantest/localwhisper/TranscriptionService.java')
+jni = txt('app/src/main/java/win/fantest/localwhisper/WhisperNative.java')
+
+checks = {
+    'v024 version': 'versionCode = 8' in build and 'versionName = "0.2.4"' in build,
+    'KleidiAI enabled in CMake': 'GGML_CPU_KLEIDIAI ON' in cmake,
+    'KleidiAI enabled in Gradle': '"-DGGML_CPU_KLEIDIAI=ON"' in build,
+    'fast default preference': 'PERFORMANCE_FAST' in prefs and 'prefs.getString(KEY_PERFORMANCE, PERFORMANCE_FAST)' in prefs,
+    'performance selector': 'performanceSpinner' in ui and 'Fast · Large v3 Turbo optimized' in ui,
+    'performance persisted': 'setPerformanceProfile' in main and 'performanceProfile()' in service,
+    'JNI performance profile': 'String performanceProfile' in jni and 'jstring performanceProfile' in native,
+    'fast greedy': 'WHISPER_SAMPLING_GREEDY' in native and 'params.greedy.best_of = 1' in native,
+    'balanced small beam': 'seconds <= 20.0f ? 3 : 2' in native,
+    'accurate legacy beam': 'seconds <= 20.0f ? 8 : 5' in native,
+    'thread tuning': 'desiredThreads' in native and 'std::min(8u, std::max(2u, desiredThreads))' in native,
+    'native timing': 'elapsed_ms=' in native and 'speed=%.2fx' in native,
+    'resident engine cache': 'cachedEngine' in service and 'acquireEngine(model)' in service,
+    'performance telemetry': 'x realtime' in service,
+}
+failed = [name for name, ok in checks.items() if not ok]
+if failed:
+    raise SystemExit('FAIL: ' + ', '.join(failed))
+print('PASS: v0.2.4 performance contract')
